<Window x:Class="RidelanceSpv.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RIDElance SPV" Width="560" Height="720" MinWidth="480" MinHeight="560"
        Background="{StaticResource Page}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Image Source="Assets/logo.png" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Background="{StaticResource Primary}" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="SPV" FontSize="13" FontWeight="Bold" Foreground="White" />
        </Border>
      </StackPanel>

      <!-- Conectarea: cheia generată în RIDElance (admin: Contabilitate → ANAF → Aplicația SPV) -->
      <Border x:Name="ConnectCard" Style="{StaticResource Card}" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Conectare" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
          <TextBlock Text="Cheie" Style="{StaticResource Label}" />
          <PasswordBox x:Name="KeyBox" Height="34" Padding="8,6" FontSize="14" />
          <TextBlock Text="Server" Style="{StaticResource Label}" />
          <TextBox x:Name="ServerBox" Height="34" Padding="8,6" FontSize="14" />
          <TextBlock x:Name="ConnectError" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
          <Button x:Name="ConnectButton" Content="Conectează" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnConnect" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="MainPanel" Visibility="Collapsed">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Cont" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AccountText" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="1" Text="PFA-uri" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PfasText" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="2" Text="Certificat" Style="{StaticResource Label}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="CertificateText" Style="{StaticResource Value}" MaxWidth="260" />
              <Button Content="Alege" Style="{StaticResource QuietButton}" Padding="10,4" Margin="10,2,0,2" Click="OnChooseCertificate" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Ultima trimitere" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastText" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="4" Text="Următoarea" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="NextText" Style="{StaticResource Value}" />
            <TextBlock Grid.Row="5" Text="Cereri în așteptare" Style="{StaticResource Label}" />
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="QueuedText" Style="{StaticResource Value}" />
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SendButton" Content="Trimite acum" Style="{StaticResource PrimaryButton}" Click="OnSendNow" />
              <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <RadioButton Content="30 min" Tag="30" GroupName="Interval" Style="{StaticResource Pill}" Checked="OnIntervalChanged" />
                <RadioButton Content="1 oră" Tag="60" GroupName="Interval" Style="{StaticResource Pill}" Checked="OnIntervalChanged" />
                <RadioButton Content="3 ore" Tag="180" GroupName="Interval" Style="{StaticResource Pill}" Checked="OnIntervalChanged" />
              </StackPanel>
            </StackPanel>
            <CheckBox x:Name="StartupBox" Content="Pornește odată cu Windows" FontSize="14" Margin="0,14,0,0" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Jurnal" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
            <ItemsControl x:Name="LogList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Button Content="Deconectează" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Click="OnDisconnect" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
